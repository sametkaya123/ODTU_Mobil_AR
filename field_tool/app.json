{
  "expo": {
    "name": "Saha Referans Toplama",
    "slug": "field_tool",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F6E6E",
      "image": "./assets/splash-icon.png"
    },
    "assetBundlePatterns": [
      "assets/**/*",
      "**/*.jpg",
      "**/*.png",
      "**/*.webp",
      "**/*.svg",
      "**/*.ttf"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.metu.odtumobil.fieldtool"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F6E6E"
      },
      "package": "edu.metu.odtumobil.fieldtool",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-location",
      "onnxruntime-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "fieldtool",
    "extra": {
      "eas": {
        "projectId": "ee9af6a3-2229-403f-ae15-9088b99193fb"
      }
    }
  }
}
