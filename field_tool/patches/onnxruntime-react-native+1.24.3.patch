   return rootProject.ext.has(name) ? rootProject.ext.get(name) : (project.properties['OnnxruntimeModule_' + name]).toInteger()
 }
 
+// Gradle 9 removed org.gradle.util.VersionNumber (and it was never imported
+// here to begin with, relying on an implicit import older Gradle provided) -
+// plain string comparison instead of depending on any Gradle-internal API.
+def isVersionAtLeast(String version, String minVersion) {
+  def toParts = { String v -> v.split(/[-+]/)[0].tokenize('.').collect { it.isInteger() ? it.toInteger() : 0 } }
+  def vParts = toParts(version)
+  def mParts = toParts(minVersion)
+  def n = Math.max(vParts.size(), mParts.size())
+  for (int i = 0; i < n; i++) {
+    int a = i < vParts.size() ? vParts[i] : 0
+    int b = i < mParts.size() ? mParts[i] : 0
+    if (a != b) return a > b
+  }
+  return true
+}
